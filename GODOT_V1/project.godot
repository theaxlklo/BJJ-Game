; Godot project for the isolated GDScript implementation of BJJ Game.
; Target editor/runtime: Godot 4.7.2-stable (standard GDScript build).
config_version=5

[application]

config/name="BJJ Game — Godot V1"
run/main_scene="res://scenes/mount_practice.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
